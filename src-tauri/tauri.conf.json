{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoForge",
  "version": "0.15.2",
  "identifier": "com.photoforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhotoForge",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "installer/Tauri-MIT.txt": "licenses/Tauri-MIT.txt"
    },
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Private, local photo enhancement",
    "longDescription": "PhotoForge restores and enhances photos locally without uploading images.",
    "windows": {
      "allowDowngrades": false,
      "nsis": { "installMode": "currentUser" },
      "wix": {
        "template": "installer/photoforge.wxs",
        "upgradeCode": "da34c5f7-e5bb-583b-93f8-1f4e4065dc14"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
