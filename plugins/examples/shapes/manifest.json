{
  "format": "photoforge-plugin",
  "formatVersion": 1,
  "apiVersion": 1,
  "id": "photoforge.example.shapes",
  "name": "Shape Generator",
  "version": "1.0.0",
  "publisher": "PhotoForge examples",
  "description": "Draws a circle, square or diamond onto a new layer.",
  "license": "MIT",
  "capabilities": [
    "filter.pixels",
    "document.operations",
    "ui.tool"
  ],
  "filters": [
    {
      "id": "shape",
      "title": "Draw shape",
      "description": "A generator: it ignores the layer and draws the shape.",
      "locality": {
        "kind": "pointwise"
      },
      "parameters": [
        {
          "id": "shape",
          "title": "Shape",
          "type": "choice",
          "options": [
            "Circle",
            "Square",
            "Diamond"
          ],
          "default": 0
        },
        {
          "id": "size",
          "title": "Size",
          "description": "As a fraction of the shorter side of the image.",
          "type": "number",
          "min": 0.05,
          "max": 1,
          "default": 0.5
        }
      ]
    }
  ],
  "commands": [
    {
      "id": "add_shape",
      "title": "Add shape layer",
      "description": "Adds a new layer and draws the shape on it, as one undoable step.",
      "parameters": [
        {
          "id": "shape",
          "title": "Shape",
          "type": "choice",
          "options": [
            "Circle",
            "Square",
            "Diamond"
          ],
          "default": 0
        },
        {
          "id": "size",
          "title": "Size",
          "description": "",
          "type": "number",
          "min": 0.05,
          "max": 1,
          "default": 0.5
        }
      ],
      "steps": [
        {
          "op": "core.layer.add_pixel",
          "params": {
            "name": "Shape"
          }
        },
        {
          "op": "core.plugin.apply_filter",
          "params": {
            "selector": {
              "type": "last_created"
            },
            "plugin": "$self",
            "filter": "shape",
            "parameters": {
              "shape": {
                "$param": "shape"
              },
              "size": {
                "$param": "size"
              }
            }
          }
        }
      ]
    }
  ],
  "tools": [
    {
      "id": "add_shape",
      "title": "Add shape",
      "description": "Draw a shape on a new layer.",
      "command": "add_shape"
    }
  ]
}
