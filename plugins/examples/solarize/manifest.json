{
  "format": "photoforge-plugin",
  "formatVersion": 1,
  "apiVersion": 1,
  "id": "photoforge.example.solarize",
  "name": "Solarize",
  "version": "1.0.0",
  "publisher": "PhotoForge examples",
  "description": "Inverts every channel brighter than a threshold, as in a solarised print.",
  "license": "MIT",
  "capabilities": [
    "filter.pixels"
  ],
  "filters": [
    {
      "id": "solarize",
      "title": "Solarize",
      "locality": {
        "kind": "pointwise"
      },
      "parameters": [
        {
          "id": "threshold",
          "title": "Threshold",
          "description": "Channels above this are inverted.",
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0.5
        }
      ]
    }
  ]
}
