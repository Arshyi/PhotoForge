{
  "format": "photoforge-plugin",
  "formatVersion": 1,
  "apiVersion": 1,
  "id": "photoforge.example.border",
  "name": "Add Border",
  "version": "1.0.0",
  "publisher": "PhotoForge examples",
  "description": "Draws a solid border of a chosen width and colour around the edge of a layer.",
  "license": "MIT",
  "capabilities": [
    "filter.pixels"
  ],
  "filters": [
    {
      "id": "add_border",
      "title": "Add border",
      "description": "Paints the outermost pixels of the layer.",
      "locality": {
        "kind": "pointwise"
      },
      "parameters": [
        {
          "id": "width",
          "title": "Width (pixels)",
          "type": "integer",
          "min": 0,
          "max": 200,
          "default": 8
        },
        {
          "id": "red",
          "title": "Red",
          "description": "",
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0
        },
        {
          "id": "green",
          "title": "Green",
          "description": "",
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0
        },
        {
          "id": "blue",
          "title": "Blue",
          "description": "",
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0
        }
      ]
    }
  ]
}
